# ── Build / OS noise ───────────────────────────────────────────────────────
*.json
!vercel.json
__pycache__/
*.pyc
.DS_Store
*.preview.html

# ── Secrets: never commit ──────────────────────────────────────────────────
.env
.env.*
!.env.example
.credentials
.credentials/
credentials.json
client_secret*.json
service-account*.json
*-key.json
.netrc
.npmrc
.pypirc

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.gpg
*.asc

# Cloud CLI caches
.gcloud/
.aws/
gha-creds-*.json

# ── IDE / editor state (can hold tokens in workspace settings) ─────────────
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.code-workspace
.history/

# ── Local scratch ──────────────────────────────────────────────────────────
*.local
.cache/
tmp/
